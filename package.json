{
  "name": "jww-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/jww/index.js",
  "description": "Standalone JWW v600/v700 import, conversion, diagnostics, semantic diff, and bounded writer.",
  "exports": {
    ".": "./src/jww/index.js",
    "./native": "./src/jww/native.js",
    "./geometry": "./src/jww/arcGeometry.js",
    "./writer": "./src/jww/writer.js",
    "./semantic-diff": "./src/jww/semanticDiff.js"
  },
  "bin": {
    "jww-gateway": "./tools/jww-gateway.mjs",
    "jww-coverage": "./tools/jww-coverage.mjs",
    "jww-coverage-summary": "./tools/jww-coverage-summary.mjs",
    "jww-diagnostics": "./tools/jww-diagnostics.mjs",
    "jww-diagnostics-diff": "./tools/jww-diagnostics-diff.mjs",
    "jww-schema-validate": "./tools/jww-schema-validate.mjs",
    "jww-env-scan": "./tools/jww-env-scan.mjs",
    "jww-conformance": "./tools/jww-conformance.mjs",
    "jww-writer": "./tools/jww-writer.mjs",
    "jww-semantic-diff": "./tools/jww-semantic-diff.mjs",
    "jwf-parse": "./tools/jwf-parse.mjs",
    "jww-jwf-compare": "./tools/jww-jwf-compare.mjs",
    "jww-jwf-value-scan": "./tools/jww-jwf-value-scan.mjs",
    "jww-layer-defaults-audit": "./tools/jww-layer-defaults-audit.mjs",
    "jww-layer-defaults-summary": "./tools/jww-layer-defaults-summary.mjs",
    "jww-special-color-audit": "./tools/jww-special-color-audit.mjs",
    "jww-special-color-summary": "./tools/jww-special-color-summary.mjs",
    "jww-value-scan-summary": "./tools/jww-value-scan-summary.mjs",
    "jww-core-open-summary": "./tools/jww-core-open-summary.mjs",
    "jww-sample-plan": "./tools/jww-sample-plan.mjs",
    "jww-gateway-open-items": "./tools/jww-gateway-open-items.mjs",
    "jww-gateway-report-index": "./tools/jww-gateway-report-index.mjs",
    "jww-manifest-validate": "./tools/jww-manifest-validate.mjs",
    "jww-gateway-status": "./tools/jww-gateway-status.mjs",
    "jww-gateway-verify-report": "./tools/jww-gateway-verify-report.mjs",
    "jww-gateway-verify-report-diff": "./tools/jww-gateway-verify-report-diff.mjs"
  },
  "scripts": {
    "convert": "node --no-warnings tools/jww-gateway.mjs",
    "coverage": "node --no-warnings tools/jww-coverage.mjs",
    "coverage:summary": "node --no-warnings tools/jww-coverage-summary.mjs",
    "diagnose": "node --no-warnings tools/jww-diagnostics.mjs",
    "diff": "node --no-warnings tools/jww-diagnostics-diff.mjs",
    "validate": "node --no-warnings tools/jww-schema-validate.mjs",
    "env:scan": "node --no-warnings tools/jww-env-scan.mjs",
    "conformance": "node --no-warnings tools/jww-conformance.mjs",
    "write": "node --no-warnings tools/jww-writer.mjs",
    "semantic:diff": "node --no-warnings tools/jww-semantic-diff.mjs",
    "roundtrip:corpus": "node --no-warnings tools/jww-roundtrip-corpus.mjs",
    "jwf:parse": "node --no-warnings tools/jwf-parse.mjs",
    "jwf:compare": "node --no-warnings tools/jww-jwf-compare.mjs",
    "jwf:value-scan": "node --no-warnings tools/jww-jwf-value-scan.mjs",
    "layer-defaults:audit": "node --no-warnings tools/jww-layer-defaults-audit.mjs",
    "layer-defaults:summary": "node --no-warnings tools/jww-layer-defaults-summary.mjs",
    "special-color:audit": "node --no-warnings tools/jww-special-color-audit.mjs",
    "special-color:summary": "node --no-warnings tools/jww-special-color-summary.mjs",
    "value-scan:summary": "node --no-warnings tools/jww-value-scan-summary.mjs",
    "core:summary": "node --no-warnings tools/jww-core-open-summary.mjs",
    "sample:plan": "node --no-warnings tools/jww-sample-plan.mjs",
    "open-items": "node --no-warnings tools/jww-gateway-open-items.mjs",
    "reports:index": "node --no-warnings tools/jww-gateway-report-index.mjs",
    "manifest:validate": "node --no-warnings tools/jww-manifest-validate.mjs",
    "status": "node --no-warnings tools/jww-gateway-status.mjs",
    "verify:report": "node --no-warnings tools/jww-gateway-verify-report.mjs",
    "verify:conformance": "npm run conformance -- samples --recursive --require-clean-parse --json -o reports\\conformance.json",
    "verify:reports": "npm run verify:report -- -o reports\\verify-report.txt && npm run verify:report -- --json -o reports\\verify-report.json && npm run verify:report -- --csv -o reports\\verify-report.csv && npm run verify:report -- --html -o reports\\verify-report.html",
    "verify:diff": "node --no-warnings tools/jww-gateway-verify-report-diff.mjs",
    "test": "node --import ./src/jww/testHarness.js --test src/jww/*.test.js",
    "test:jww": "npm run test",
    "smoke": "node --no-warnings tools/jww-gateway-smoke.mjs",
    "verify": "npm run smoke && npm run manifest:validate -- JWW_GATEWAY_MANIFEST.json --check-files --json",
    "verify:all": "npm run verify && npm run verify:conformance && npm run verify:reports && npm run open-items -- --json -o reports\\open-items.json && npm run open-items -- --html -o reports\\open-items.html && npm run reports:index -- --json -o reports\\index.json && npm run reports:index -- --html -o reports\\index.html",
    "verify:handoff": "npm run verify:all && npm run verify:report -- --expect-no-unresolved"
  },
  "engines": {
    "node": ">=18"
  }
}
